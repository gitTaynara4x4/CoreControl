# Ambiente local. O script Iniciar_CoreControl_Local copia este arquivo para .env.
CORETUNER_ENV=development
CORETUNER_PORT=8002
CORETUNER_PUBLIC_URL=http://127.0.0.1:8002

CORETUNER_SECRET_KEY=coretuner-local-chave-segura-123456789012345
CORETUNER_ADMIN_EMAIL=admin@coretuner.com.br
CORETUNER_ADMIN_PASSWORD=TroqueAgora123!
CORETUNER_DOWNLOAD_PASSWORD=0610

# Sem esta variável, o modo local usa SQLite em ./data/coretuner.db.
# CORETUNER_DATABASE_URL=postgresql+psycopg://usuario:senha@host:porta/banco?sslmode=disable

CORETUNER_DOWNLOAD_TOKEN_SECONDS=180
CORETUNER_DOWNLOAD_MAX_ATTEMPTS=5
CORETUNER_DOWNLOAD_ATTEMPT_WINDOW_SECONDS=600
CORETUNER_DOWNLOAD_BLOCK_SECONDS=900
CORETUNER_OFFLINE_AFTER_SECONDS=180
CORETUNER_TELEMETRY_RETENTION_DAYS=30

# Recuperação de senha por e-mail. Deixe usuário/senha vazios para desativar localmente.
CORETUNER_SMTP_HOST=smtp.gmail.com
CORETUNER_SMTP_PORT=587
CORETUNER_SMTP_USER=
CORETUNER_SMTP_PASSWORD=
CORETUNER_SMTP_FROM_EMAIL=
CORETUNER_SMTP_FROM_NAME=CoreControl
CORETUNER_SMTP_STARTTLS=true
CORETUNER_PASSWORD_RESET_MINUTES=20
CORETUNER_PASSWORD_RESET_MAX_ATTEMPTS=5
CORETUNER_PASSWORD_RESET_WINDOW_SECONDS=900

# Acesso remoto (MeshCentral). Desativado localmente por padrão.
CORETUNER_REMOTE_ENABLED=false
CORETUNER_REMOTE_URL=https://apps-coretuner-remote.9ywrah.easypanel.host
CORETUNER_REMOTE_AGENT_FILENAME=CoreTunerRemoteAgent.exe
CORETUNER_REMOTE_LOGIN_TOKEN_KEY=
CORETUNER_REMOTE_LOGIN_USER=coretuner-integracao
CORETUNER_REMOTE_LOGIN_DOMAIN=
CORETUNER_REMOTE_LOGIN_TOKEN_MINUTES=2
CORETUNER_REMOTE_ADMIN_USER=user-mesh-adm
CORETUNER_REMOTE_NODE_PATH=node
CORETUNER_REMOTE_MESHCTRL_PATH=/opt/meshcentral-client/node_modules/meshcentral/meshctrl.js
CORETUNER_REMOTE_AGENT_TYPE=4
CORETUNER_REMOTE_AGENT_INSTALL_FLAGS=2
CORETUNER_REMOTE_GROUP_FEATURES=2
CORETUNER_REMOTE_GROUP_CONSENT=65
CORETUNER_REMOTE_COMMAND_TIMEOUT_SECONDS=45
CORETUNER_REMOTE_AGENT_DOWNLOAD_TIMEOUT_SECONDS=90
CORETUNER_REMOTE_AGENT_CACHE_SECONDS=86400
CORETUNER_REMOTE_STATUS_CACHE_SECONDS=15
CORETUNER_REMOTE_STATUS_STALE_SECONDS=120
