{
  "manifest_version": 3,
  "name": "CoreControl - Atividade do Navegador",
  "version": "0.1.0",
  "description": "Integra o navegador ao CoreControl para mostrar abas abertas e qual página está em uso.",
  "key": "",
  "permissions": ["tabs", "nativeMessaging", "alarms", "storage"],
  "background": {"service_worker": "background.js"},
  "action": {
    "default_title": "CoreControl",
    "default_popup": "popup.html"
  }
}
